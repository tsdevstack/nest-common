{
  "name": "@tsdevstack/nest-common",
  "version": "0.10.0",
  "description": "Shared NestJS modules for tsdevstack microservices — auth, rate limiting, secrets, observability, and more",
  "type": "commonjs",
  "author": "tsdevstack",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsdevstack/nest-common.git"
  },
  "homepage": "https://github.com/tsdevstack/nest-common",
  "bugs": {
    "url": "https://github.com/tsdevstack/nest-common/issues"
  },
  "keywords": [
    "tsdevstack",
    "nestjs",
    "microservices",
    "auth",
    "rate-limiting",
    "secrets-management",
    "observability",
    "opentelemetry",
    "prisma",
    "redis"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "tsc --noEmit --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "rstest run",
    "test:redis": "docker run --rm -d --name nest-common-redis-itest -p 6399:6379 redis:7-alpine >/dev/null && sleep 1 && REDIS_TEST_URL=redis://127.0.0.1:6399 rstest run; code=$?; docker rm -f nest-common-redis-itest >/dev/null 2>&1; docker rm -f nest-common-redis-reconnect-itest >/dev/null 2>&1; exit $code",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1006.0",
    "@aws-sdk/client-secrets-manager": "^3.984.0",
    "@aws-sdk/lib-storage": "^3.1006.0",
    "@aws-sdk/s3-request-presigner": "^3.1006.0",
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.4.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.0.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^1.0.4",
    "@rstest/adapter-rslib": "^0.12.4",
    "@rstest/core": "^0.12.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.11",
    "eslint": "^10.7.0",
    "globals": "^17.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0"
  }
}
